# ==============================================================================
# Website Health Monitor with Auto-Alerts - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and customize values for your environment.
# Note: The application will run normally without SMTP credentials configured.
# Email alerts will be automatically marked as "skipped (no SMTP)" until configured.

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=dev-secret-key-change-in-production

# Monitoring Settings
# Interval between background checks in seconds (e.g., 60 = 1 minute)
CHECK_INTERVAL=60

# HTTP request timeout per website check in seconds
REQUEST_TIMEOUT=8

# Retention period for historical checks in days (older records pruned automatically)
HISTORY_RETENTION_DAYS=30

# Max websites allowed to monitor
MAX_WEBSITES=50

# ------------------------------------------------------------------------------
# Email Alert Settings (Optional - leave blank if not sending real emails)
# ------------------------------------------------------------------------------
# SMTP server host (e.g. smtp.gmail.com, smtp.office365.com, mail.example.com)
SMTP_HOST=

# SMTP server port (587 for STARTTLS, 465 for SSL, or 25)
SMTP_PORT=587

# SMTP credentials (use an App Password for Gmail/Outlook)
SMTP_USER=
SMTP_PASS=

# Sender email address (e.g., alerts@yourdomain.com)
ALERT_FROM_EMAIL=

# Recipient email address to receive alerts (e.g., admin@yourdomain.com)
ALERT_TO_EMAIL=

# Set to True to use TLS (typically port 587)
SMTP_USE_TLS=True

# Set to True to use SSL (typically port 465)
SMTP_USE_SSL=False
